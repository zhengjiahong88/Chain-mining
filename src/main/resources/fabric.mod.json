{
	"schemaVersion": 1,
	"id": "chain_mining",
	"version": "${version}",
	"name": "Chain mining mod",
	"description": "This is a chain mining description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/zhengjiahong88/Fabric-Example.git"
	},
	"license": "CC0-1.0",
	"icon": "assets/chain_mining/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.chain_mining.ChainMiningMod"
		],
		"client": [
			"com.chain_mining.ChainMiningModClient"
		]
	},
	"mixins": [
